# Copiare in .env. Non committare segreti reali.
# Postgres (generate e migrate). In M0 un URL fittizio basta per prisma generate.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/esl_player_hub?schema=public"

# Auth.js — stringa lunga e casuale in produzione
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Adapter: stub di default. Live solo se driver + config completi (fail closed).
EMAIL_DRIVER="stub"
EMAIL_FROM="ESL Player Hub <noreply@example.test>"
RESEND_API_KEY=""

STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

PAYMENT_DRIVER="stub"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

MONITORING_PROVIDER="stub"

# Regole configurabili
AGE_OF_MAJORITY="18"
SIGNED_URL_TTL_SECONDS="60"
MAX_UPLOAD_BYTES="10485760"
INVITE_TTL_DAYS="14"
