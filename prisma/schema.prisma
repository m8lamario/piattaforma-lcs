generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  TEAM_REPRESENTATIVE
  ORGANIZATION_ADMIN
  MEDICAL_REVIEWER
  SUPER_ADMIN
  COMPETITION_ORGANIZER
}

enum MembershipRole {
  PLAYER
  REPRESENTATIVE
}

enum RegistrationStatus {
  INVITED
  ACCOUNT_CREATED
  IN_PROGRESS
  PENDING_REVIEW
  CHANGES_REQUESTED
  PAYMENT_PENDING
  APPROVED
  WITHDRAWN
  REMOVED
}

enum UserLifecycleStatus {
  ACTIVE
  DELETED
  ANONYMIZED
}

enum PaymentMode {
  PLAYER
  TEAM
  BOTH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DocumentStatus {
  UPLOADED
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REPLACED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum RequirementCode {
  PERSONAL_DATA
  GUARDIAN_IF_MINOR
  MEDICAL_CERT
  PRIVACY
  MEDIA_RELEASE
  PAYMENT
}

enum RequirementAudience {
  ALL
  MINOR
  ADULT
}

enum LegalAudience {
  ALL
  MINOR
  ADULT
  GUARDIAN
}

enum ConsentType {
  REQUIRED
  OPTIONAL
}

enum ActorKind {
  USER
  GUARDIAN_LINK
  SYSTEM
}

enum GuardianAuthorizationStatus {
  PENDING
  OPENED
  AUTHORIZED
  REFUSED
  EXPIRED
  SUPERSEDED
  REVOKED
}

enum GuardianAuthorizationType {
  ENROLLMENT
  PUBLICATION
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  FAILED
}

enum EmailRecipientKind {
  USER
  GUARDIAN
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  emailVerified    DateTime?
  passwordHash     String?
  name             String?
  image            String?
  lifecycleStatus  UserLifecycleStatus @default(ACTIVE)
  deletedAt        DateTime?
  anonymizedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  accounts               Account[]
  sessions               Session[]
  roles                  UserRole[]
  playerProfile          PlayerProfile?
  teamMemberships        TeamMembership[]
  invitedPlayers         PlayerInvite[]      @relation("InviteAuthor")
  acceptedInvites        PlayerInvite[]      @relation("InviteAcceptedBy")
  invitedStaff           StaffInvite[]       @relation("StaffInviteAuthor")
  acceptedStaffInvites   StaffInvite[]       @relation("StaffInviteAcceptedBy")
  documentReviews        DocumentReview[]
  notifications          Notification[]
  consentRecords         ConsentRecord[]
  consentChoices         ConsentChoice[]
  auditLogs              AuditLog[]
  payments               Payment[]           @relation("PaymentPayer")
  representativeTeams    Team[]              @relation("TeamRepresentativeUser")
  emailMessagesReceived  EmailMessage[]      @relation("EmailRecipient")
  emailMessagesSent      EmailMessage[]      @relation("EmailActor")
  emailTemplateEdits     EmailTemplateOverride[] @relation("EmailTemplateEditor")

  @@index([lifecycleStatus])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

/// Scope: PLAYER e gli admin di piattaforma non hanno FK.
/// TEAM_REPRESENTATIVE richiede teamId (l'edizione si legge da Team, non si duplica).
/// COMPETITION_ORGANIZER richiede competitionId e copre tutte le Edition di quella Competition.
/// Non c'è editionId: un ruolo per edizione duplicherebbe Team.editionId e potrebbe divergere.
model UserRole {
  id            String   @id @default(cuid())
  userId        String
  role          Role
  teamId        String?
  competitionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([userId, role])
  @@index([teamId])
  @@index([competitionId])
}

model PlayerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  firstName   String
  lastName    String
  birthDate   DateTime? @db.Date
  fiscalCode  String?   @unique
  phone       String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians        Guardian[]
  registrations    Registration[]
  documents        Document[]
  authorizations   GuardianAuthorization[]
  guardianTokens   GuardianLinkToken[]

  @@index([lastName, firstName])
}

model Guardian {
  id                   String   @id @default(cuid())
  playerProfileId      String
  firstName            String
  lastName             String
  relationship         String
  email                String
  phone                String?
  kind                 String   @default("PRIMARY")
  soleResponsibility   Boolean  @default(false)
  emailCorrectionUsed  Boolean  @default(false)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  playerProfile  PlayerProfile             @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  consentRecords ConsentRecord[]
  consentChoices ConsentChoice[]
  consentTokens  ConsentToken[]
  authorizations GuardianAuthorization[]
  linkTokens     GuardianLinkToken[]
  auditLogs      AuditLog[]

  @@unique([playerProfileId, email])
  @@index([playerProfileId])
}

model Competition {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent              Competition? @relation("CompetitionTree", fields: [parentId], references: [id])
  children            Competition[] @relation("CompetitionTree")
  editions  Edition[]
  userRoles UserRole[]

  @@index([parentId])
}

model Edition {
  id              String      @id @default(cuid())
  competitionId   String
  name            String
  year            Int
  registrationOpensAt DateTime?
  registrationClosesAt DateTime?
  startsAt        DateTime?
  endsAt          DateTime?
  playerFeeAmount Decimal?    @db.Decimal(10, 2)
  teamFeeAmount   Decimal?    @db.Decimal(10, 2)
  currency        String      @default("EUR")
  paymentMode     PaymentMode @default(PLAYER)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  competition  Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  teams        Team[]
  registrations Registration[]
  requirements EditionRequirement[]
  payments     Payment[]

  @@unique([competitionId, year, name])
  @@index([competitionId])
  @@index([isActive])
}

model EditionRequirement {
  id        String               @id @default(cuid())
  editionId String
  code      RequirementCode
  required  Boolean              @default(true)
  appliesTo RequirementAudience  @default(ALL)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, code, appliesTo])
  @@index([editionId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  city      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]

  @@index([name])
}

model Team {
  id                   String   @id @default(cuid())
  editionId            String
  schoolId             String
  name                 String
  logoStorageKey       String?
  inviteCode           String   @unique
  registrationToken    String   @unique
  contactName          String?
  contactEmail         String?
  representativeUserId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  edition        Edition          @relation(fields: [editionId], references: [id], onDelete: Restrict)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  representative User?            @relation("TeamRepresentativeUser", fields: [representativeUserId], references: [id])
  memberships    TeamMembership[]
  invites        PlayerInvite[]
  staffInvites   StaffInvite[]
  registrations  Registration[]
  payments       Payment[]
  userRoles      UserRole[]

  // Bersaglio della FK composta (id, editionId). id è già unico; la coppia serve a Registration e Payment.
  @@unique([id, editionId])
  @@index([editionId])
  @@index([schoolId])
  @@index([representativeUserId])
}

model TeamMembership {
  id           String         @id @default(cuid())
  teamId       String
  userId       String
  role         MembershipRole @default(PLAYER)
  jerseyNumber String?
  rosterRole   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model PlayerInvite {
  id              String       @id @default(cuid())
  teamId          String
  email           String
  tokenHash       String       @unique
  status          InviteStatus @default(PENDING)
  firstName       String?
  lastName        String?
  expiresAt       DateTime
  invitedByUserId  String
  acceptedByUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InviteAuthor", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, email])
  @@index([status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
}

model StaffInvite {
  id               String       @id @default(cuid())
  teamId           String
  email            String
  tokenHash        String       @unique
  status           InviteStatus @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String
  acceptedByUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("StaffInviteAuthor", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy User? @relation("StaffInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, email])
  @@index([status])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
}

model Registration {
  id              String              @id @default(cuid())
  playerProfileId String
  teamId          String
  editionId       String
  status          RegistrationStatus  @default(INVITED)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  playerProfile  PlayerProfile   @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  team           Team            @relation(fields: [teamId, editionId], references: [id, editionId], onDelete: Restrict, onUpdate: Restrict)
  edition        Edition         @relation(fields: [editionId], references: [id], onDelete: Restrict)
  documents      Document[]
  consentRecords ConsentRecord[]
  consentChoices ConsentChoice[]
  consentTokens  ConsentToken[]
  authorizations GuardianAuthorization[]
  guardianTokens GuardianLinkToken[]
  payments       Payment[]

  @@unique([playerProfileId, editionId])
  @@unique([id, editionId])
  @@index([teamId])
  @@index([editionId, status])
}

model DocumentType {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  allowedMime    String[]
  maxSizeBytes   Int
  requiresExpiry Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents Document[]
}

model Document {
  id               String         @id @default(cuid())
  registrationId   String
  playerProfileId  String
  typeId           String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  originalFilename String
  status           DocumentStatus @default(UPLOADED)
  uploadedAt       DateTime       @default(now())
  expiresAt        DateTime?
  replacedById     String?        @unique
  blobPurgedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  registration  Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile    @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  type          DocumentType     @relation(fields: [typeId], references: [id], onDelete: Restrict)
  replacedBy    Document?        @relation("DocumentReplacement", fields: [replacedById], references: [id])
  replaces      Document?        @relation("DocumentReplacement")
  reviews       DocumentReview[]

  @@index([registrationId, status])
  @@index([playerProfileId])
  @@index([typeId])
}

model DocumentReview {
  id           String         @id @default(cuid())
  documentId   String
  reviewerId   String
  decision     ReviewDecision
  reason       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([reviewerId])
}

model LegalDocument {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  audience          LegalAudience @default(ALL)
  requiredByDefault Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  versions LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id              String   @id @default(cuid())
  legalDocumentId String
  version         String
  body            String
  effectiveAt     DateTime
  isCurrent       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  legalDocument   LegalDocument              @relation(fields: [legalDocumentId], references: [id], onDelete: Cascade)
  consents        ConsentRecord[]
  choices         ConsentChoice[]
  authorizations  GuardianAuthorization[]
  decisions       GuardianAuthorizationDecision[]
  auditLogs       AuditLog[]

  @@unique([legalDocumentId, version])
  @@index([legalDocumentId, isCurrent])
}

model ConsentRecord {
  id                      String      @id @default(cuid())
  userId                  String
  legalDocumentVersionId  String
  registrationId          String?
  guardianId              String?
  consentType             ConsentType
  accepted                Boolean
  acceptedAt              DateTime    @default(now())
  clauseText              String?
  actorKind               ActorKind   @default(USER)
  actorRole               String?
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocumentVersion LegalDocumentVersion @relation(fields: [legalDocumentVersionId], references: [id], onDelete: Restrict)
  registration         Registration?        @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  guardian             Guardian?            @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([userId, legalDocumentVersionId])
  @@index([registrationId])
}

model ConsentChoice {
  id                     String    @id @default(cuid())
  userId                 String
  registrationId         String
  code                   String
  accepted               Boolean
  value                  String?
  source                 String    @default("WEB")
  legalDocumentVersionId String?
  guardianId             String?
  clauseText             String?
  actorKind              ActorKind @default(USER)
  actorRole              String?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime  @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration         Registration          @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  legalDocumentVersion LegalDocumentVersion? @relation(fields: [legalDocumentVersionId], references: [id], onDelete: SetNull)
  guardian             Guardian?             @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([registrationId, code, createdAt])
  @@index([userId, code])
}

model ConsentToken {
  id             String    @id @default(cuid())
  registrationId String
  purpose        String
  tokenHash      String    @unique
  email          String
  guardianId     String?
  expiresAt      DateTime
  usedAt         DateTime?
  reminderSentAt DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  guardian     Guardian?    @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@index([registrationId, purpose])
}

model GuardianAuthorization {
  id                     String                       @id @default(cuid())
  guardianId             String
  playerProfileId        String
  registrationId         String
  tokenId                String?                      @unique
  status                 GuardianAuthorizationStatus  @default(PENDING)
  authorizationType      GuardianAuthorizationType
  requestedAt            DateTime                     @default(now())
  openedAt               DateTime?
  authorizedAt           DateTime?
  revokedAt              DateTime?
  ipAddress              String?
  userAgent              String?
  legalDocumentVersionId String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  guardian             Guardian                       @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  playerProfile        PlayerProfile                  @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  registration         Registration                   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  currentToken         GuardianLinkToken?             @relation("AuthorizationCurrentToken", fields: [tokenId], references: [id], onDelete: SetNull)
  legalDocumentVersion LegalDocumentVersion?          @relation(fields: [legalDocumentVersionId], references: [id], onDelete: SetNull)
  decisions            GuardianAuthorizationDecision[]
  tokens               GuardianLinkToken[]            @relation("AuthorizationTokens")
  auditLogs            AuditLog[]

  @@index([registrationId, authorizationType, status])
  @@index([guardianId, status])
  @@index([playerProfileId])
}

model GuardianAuthorizationDecision {
  id                     String   @id @default(cuid())
  authorizationId        String
  code                   String
  accepted               Boolean
  clauseText             String?
  legalDocumentVersionId String?
  createdAt              DateTime @default(now())

  authorization        GuardianAuthorization   @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  legalDocumentVersion LegalDocumentVersion?   @relation(fields: [legalDocumentVersionId], references: [id], onDelete: SetNull)

  @@index([authorizationId, createdAt])
}

model GuardianLinkToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  purpose          String
  guardianId       String
  playerProfileId  String
  registrationId   String
  authorizationId  String?
  expiresAt        DateTime
  usedAt           DateTime?
  reminderSentAt   DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  guardian      Guardian               @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  playerProfile PlayerProfile          @relation(fields: [playerProfileId], references: [id], onDelete: Cascade)
  registration  Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  authorization GuardianAuthorization? @relation("AuthorizationTokens", fields: [authorizationId], references: [id], onDelete: SetNull)
  currentFor    GuardianAuthorization? @relation("AuthorizationCurrentToken")

  @@index([authorizationId, purpose])
  @@index([registrationId, purpose])
}

model Payment {
  id                String        @id @default(cuid())
  registrationId    String?
  teamId            String?
  editionId         String
  payerUserId       String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR")
  status            PaymentStatus @default(PENDING)
  provider          String
  providerPaymentId String?
  providerSessionId String?
  paidAt            DateTime?
  failureCode       String?
  receiptUrl        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  registration Registration? @relation(fields: [registrationId, editionId], references: [id, editionId], onDelete: Restrict, onUpdate: Restrict)
  team         Team?         @relation(fields: [teamId, editionId], references: [id, editionId], onDelete: Restrict, onUpdate: Restrict)
  edition      Edition       @relation(fields: [editionId], references: [id], onDelete: Restrict)
  payer        User?         @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: SetNull)

  @@index([editionId, status])
  @@index([registrationId])
  @@index([teamId])
  @@index([provider, providerPaymentId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages EmailMessage[]

  @@index([userId, readAt])
  @@index([createdAt])
}

model EmailMessage {
  id                 String             @id @default(cuid())
  idempotencyKey     String             @unique
  purpose            String
  templateKey        String
  status             EmailStatus        @default(QUEUED)
  userId             String?
  recipientKind      EmailRecipientKind @default(USER)
  toAddress          String
  fromAddress        String
  replyTo            String?
  subject            String
  textBody           String
  provider           String
  providerMessageId  String?
  errorCode          String?
  errorMessage       String?
  sourceEntityType   String?
  sourceEntityId     String?
  notificationId     String?
  actorUserId        String?
  queuedAt           DateTime           @default(now())
  sentAt             DateTime?
  lastEventAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user         User?          @relation("EmailRecipient", fields: [userId], references: [id], onDelete: SetNull)
  actor        User?          @relation("EmailActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  notification Notification?  @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  events       EmailEvent[]

  @@index([status, queuedAt])
  @@index([purpose, queuedAt])
  @@index([userId])
  @@index([actorUserId])
  @@index([provider, providerMessageId])
  @@index([lastEventAt])
  @@index([notificationId])
}

model EmailEvent {
  id              String   @id @default(cuid())
  emailMessageId  String
  provider        String
  providerEventId String
  type            String
  occurredAt      DateTime
  bounceType      String?
  summary         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId])
  @@index([emailMessageId, occurredAt])
}

model EmailTemplateOverride {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  textBody    String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("EmailTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id                     String    @id @default(cuid())
  actorUserId            String?
  actorKind              ActorKind @default(USER)
  actorRole              String?
  guardianId             String?
  authorizationId        String?
  legalDocumentVersionId String?
  action                 String
  entityType             String
  entityId               String
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  actor          User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  guardian       Guardian?               @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  authorization  GuardianAuthorization?  @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  legalDocumentVersion LegalDocumentVersion? @relation(fields: [legalDocumentVersionId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@index([guardianId])
  @@index([authorizationId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
